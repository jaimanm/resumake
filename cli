#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

# Auto-install dependencies on first run
if [ ! -d "$DIR/src-cli/node_modules" ]; then
    echo "Installing CLI dependencies for the first time..."
    npm install --prefix "$DIR/src-cli" --silent
fi

node "$DIR/src-cli/bin/index.js" "$@"
